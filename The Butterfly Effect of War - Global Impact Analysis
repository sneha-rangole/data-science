    "        'Southeast Asia', 'Europe', 'Africa', 'Middle East',\n",
    "        'Middle East', 'South Asia', 'Middle East'\n",
    "    ],\n",
    "    'intensity': [\n",
    "        'Low', 'Medium', 'Medium', 'High',\n",
    "        'Very High', 'Very High', 'Very High', 'Very High',\n",
    "        'High', 'High', 'High'\n",
    "    ],\n",
    "    # People displaced in millions — UNHCR / IOM / UN OCHA\n",
    "    'displaced_M': [\n",
    "        4.2,   # Iraq — UNHCR historical figure\n",
    "        13.5,  # Syria — largest protracted refugee crisis globally\n",
    "        1.3,   # Libya\n",
    "        4.5,   # Yemen\n",
