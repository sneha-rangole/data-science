    "def make_cardio(n=180):\n",
    "    products = np.random.choice(['TM195', 'TM498', 'TM798'], size=n, p=[0.44, 0.33, 0.23])\n",
    "    gender = np.random.choice(['Male', 'Female'], size=n, p=[0.58, 0.42])\n",
    "    # Age: right-skewed (most customers young, a tail of older buyers)\n",
    "    age = (18 + np.random.gamma(shape=2.2, scale=4.8, size=n)).round().clip(18, 50).astype(int)\n",
    "    education = np.random.choice([12, 13, 14, 15, 16, 18, 20], size=n,\n",
    "                                 p=[0.05, 0.10, 0.22, 0.10, 0.40, 0.10, 0.03])\n",
    "    marital = np.random.choice(['Partnered', 'Single'], size=n, p=[0.59, 0.41])\n",
    "    # Fitness depends loosely on the product tier\n",
    "    tier = pd.Series(products).map({'TM195': 0, 'TM498': 1, 'TM798': 2}).values\n",
    "    fitness = np.clip(np.round(2.7 + 0.7 * tier + np.random.normal(0, 0.6, n)), 1, 5).astype(int)\n",
    "    usage = np.clip(np.round(2.5 + 0.8 * tier + np.random.normal(0, 0.9, n)), 2, 7).astype(int)\n",
    "    # Income: log-normal-ish, lifted by education and product tier -> mean > median\n",
    "    income = (np.random.lognormal(mean=10.7, sigma=0.28, size=n)\n",
    "              + 1500 * (education - 14) + 9000 * tier).round(-2).clip(29000, 105000).astype(int)\n",
    "    # Miles driven by usage and fitness, with noise\n",
    "    miles = np.clip(np.round(-56 + 20 * usage + 27 * fitness + np.random.normal(0, 18, n)),\n",
    "                    20, 360).astype(int)\n",
    "    return pd.DataFrame({\n",
    "        'Product': products, 'Age': age, 'Gender': gender, 'Education': education,\n",
    "        'MaritalStatus': marital, 'Usage': usage, 'Fitness': fitness,\n",
    "        'Income': income, 'Miles': miles,\n",
    "    })\n",
    "\n",
    "data = make_cardio()\n",
    "data.head()"
   ]
