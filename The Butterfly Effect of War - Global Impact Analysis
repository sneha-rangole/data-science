    "        4,   # Lebanon → Israel, Syria, Cyprus, Mediterranean trade routes\n",
    "    ]\n",
    "})\n",
    "\n",
    "# ── Severity score: how much ripple does each conflict send globally? ──\n",
    "# Formula: (displaced people × neighbors affected) / abs(GDP shock)\n",
    "# Higher score = bigger butterfly effect on the rest of the world\n",
    "conflicts['severity_score'] = (\n",
    "    conflicts['displaced_M'] * conflicts['neighbors_affected']\n",
    "    / conflicts['gdp_shock_pct'].abs()\n",
    ").round(2)\n",
