      3\n1         2  images/00002.png        -1       6\n2         3  images/00003.png       W35       4\n3         6  images/00006.png        -1       1\n4        14  images/00014.png       W07       3","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>image_id</th>\n      <th>image_path</th>\n      <th>writer_id</th>\n      <th>pen_id</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>1</td>\n      <td>images/00001.png</td>\n      <td>W11</td>\n      <td>3</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2</td>\n      <td>images/00002.png</td>\n      <td>-1</td>\n      <td>6</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>3</td>\n      <td>images/00003.png</td>\n      <td>W35</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>6</td>\n      <td>images/00006.png</td>\n      <td>-1</td>\n      <td>1</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>14</td>\n      <td>images/00014.png</td>\n      <td>W07</td>\n      <td>3</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":12},{"cell_type":"markdown","source":"### Chart 1 - Class Distribution\n\nA class distribution chart shows how many images exist for each pen. The ideal situation is a perfectly balanced bar chart where every pen has the same number of images. In reality, imbalance is common.\n\n**Why imbalance matters:** If pen 1 appears 5000 times and pen 8 appears only 200 times, the model can score 96% accuracy just by always predicting pen 1 - without ever learning anything about the other pens. Knowing this lets us decide whether to use class weights or oversampling to fix the problem.","metadata":{}},{"cell_type":"code","source":"# Side-by-side class distribution for both CSVs\nfig, axes = plt.subplots(1, 2, figsize=(14, 4))\npalette   = plt.cm.tab10.colors[:8]\n\nfor ax, df, title in [\n    (axes[0], train_df,     'train.csv'),\n    (axes[1], add_train_df, 'additional_train.csv'),\n]:\n    counts = df['pen_id'].value_counts().sort_index()\n    bars   = ax.bar(counts.index.astype(str), counts.values,\n                    color=palette, edgecolor='black', linewidth=0.8)\n    # Label each bar with its count\n    for bar, val in zip(bars, counts.values):\n        ax.text(bar.get_x() + bar.get_width() / 2,\n                bar.get_height() + counts.max() * 0.01,\n                str(val), ha='center', va='bottom', fontsize=9, fontweight='bold')\n    ax.set_title(f'Pen ID Distribution — {title}', fontsize=13, pad=10)\n    ax.set_xlabel('Pen ID', fontsize=11)\n    ax.set_ylabel('Number of images', fontsize=11)\n    ax.set_ylim(0, counts.max() * 1.15)\n    ax.spines[['top', 'right']].set_visible(False)\n    ratio = counts.max() / counts.min()\n    ax.annotate(f'Imbalance ratio: {ratio:.1f}x',\n                xy=(0.97, 0.95), xycoords='axes fraction',\n                ha='right', fontsize=9, color='crimson')\n\nplt.tight_layout()\nplt.savefig('eda_class_distribution.png', dpi=120, bbox_inches='tight')\nplt.show()\nprint('If the bars are roughly equal in height, the dataset is balanced.')\nprint('A large imbalance ratio (> 3x) may require class weighting.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:09.965009Z","iopub.execute_input":"2026-03-15T14:36:09.965281Z","iopub.status.idle":"2026-03-15T14:36:10.547466Z","shell.execute_reply.started":"2026-03-15T14:36:09.965259Z","shell.execute_reply":"2026-03-15T14:36:10.546837Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x400 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"If the bars are roughly equal in height, the dataset is balanced.\nA large imbalance ratio (> 3x) may require class weighting.\n","output_type":"stream"}],"execution_count":13},{"cell_type":"markdown","source":"### Chart 2 - Sample Images per Pen Class\n\nNumbers tell us counts; images tell us what the model actually has to learn. We show 4 sample circles for each of the 8 pens arranged in a grid. Look closely at each row and ask yourself: can you visually tell the pens apart? Differences to look for include line thickness, ink darkness, smoothness of the stroke edge, and whether the ink bleeds into the paper.","metadata":{}},{"cell_type":"code","source":"# 8 x 4 sample image grid (one row per pen, four images per row)\nCOLS_PER_PEN = 4\npen_classes  = sorted(train_df['pen_id'].unique())\n\nfig, axes = plt.subplots(\n    len(pen_classes), COLS_PER_PEN,\n    figsize=(COLS_PER_PEN * 2.8, len(pen_classes) * 2.8)\n)\n\nfor row_idx, pen in enumerate(pen_classes):\n    pen_rows = train_df[train_df['pen_id'] == pen]\n    samples  = pen_rows.sample(\n        min(COLS_PER_PEN, len(pen_rows)), random_state=SEED\n    )\n    for col_idx in range(COLS_PER_PEN):\n        ax = axes[row_idx, col_idx]\n        ax.axis('off')\n        if col_idx < len(samples):\n            img_path = DATA_DIR / samples.iloc[col_idx]['image_path']\n            if img_path.exists():\n                img = Image.open(img_path).convert('RGB')\n                ax.imshow(img)\n            else:\n                ax.text(0.5, 0.5, 'File\\nmissing', ha='center',\n                        va='center', transform=ax.transAxes, color='red')\n        # Label the leftmost column with the pen name\n        if col_idx == 0:\n            ax.set_title(f'Pen {pen}', fontsize=10, loc='left',\n                         fontweight='bold', color=palette[pen - 1])\n\nfig.suptitle('Sample Circle Images — One Row per Pen', fontsize=15, y=1.01)\nplt.tight_layout()\nplt.savefig('eda_sample_grid.png', dpi=80, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:10.548267Z","iopub.execute_input":"2026-03-15T14:36:10.548464Z","iopub.status.idle":"2026-03-15T14:36:12.407707Z","shell.execute_reply.started":"2026-03-15T14:36:10.548446Z","shell.execute_reply":"2026-03-15T14:36:12.406585Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1120x2240 with 32 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"markdown","source":"### Chart 3 - Image Dimension Statistics\n\nNeural networks need a fixed input size. Before choosing our resize target (224×224) we check the actual dimensions of the scanned images. If all images are already close to 224×224 we lose very little information when resizing. If they are very large (e.g. 1000×1000) we might consider using a bigger resize target like 384×384 to preserve fine stroke details.","metadata":{}},{"cell_type":"code","source":"# Sample 300 images and measure their width and height\nN_SAMPLE = 300\nsample_rows = train_df.sample(min(N_SAMPLE, len(train_df)), random_state=SEED)\n\nwidths, heights = [], []\nfor _, row in sample_rows.iterrows():\n    p = DATA_DIR / row['image_path']\n    if p.exists():\n        with Image.open(p) as img:\n            w, h = img.size\n            widths.append(w)\n            heights.append(h)\n\n# Print summary statistics\nprint(f'Sampled {len(widths)} images')\nprint(f'Width  — min: {min(widths)}   max: {max(widths)}   mean: {np.mean(widths):.0f}   std: {np.std(widths):.0f}')\nprint(f'Height — min: {min(heights)}   max: {max(heights)}   mean: {np.mean(heights):.0f}   std: {np.std(heights):.0f}')\n\n# Plot histograms of width and height\nfig, axes = plt.subplots(1, 2, figsize=(12, 3.5))\n\naxes[0].hist(widths,  bins=30, color='steelblue', edgecolor='white', alpha=0.85)\naxes[0].axvline(IMG_SIZE, color='red', linestyle='--', linewidth=1.5,\n                label=f'Resize target = {IMG_SIZE}')\naxes[0].set_title('Image Width Distribution', fontsize=12)\naxes[0].set_xlabel('Pixels'); axes[0].set_ylabel('Count')\naxes[0].legend(); axes[0].spines[['top', 'right']].set_visible(False)\n\naxes[1].hist(heights, bins=30, color='darkorange', edgecolor='white', alpha=0.85)\naxes[1].axvline(IMG_SIZE, color='red', linestyle='--', linewidth=1.5,\n                label=f'Resize target = {IMG_SIZE}')\naxes[1].set_title('Image Height Distribution', fontsize=12)\naxes[1].set_xlabel('Pixels'); axes[1].set_ylabel('Count')\naxes[1].legend(); axes[1].spines[['top', 'right']].set_visible(False)\n\nplt.tight_layout()\nplt.savefig('eda_dimensions.png', dpi=120, bbox_inches='tight')\nplt.show()\nprint('The red dashed line shows where we resize to. Most images should be near or larger than this line.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:12.408702Z","iopub.execute_input":"2026-03-15T14:36:12.409021Z","iopub.status.idle":"2026-03-15T14:36:14.907440Z","shell.execute_reply.started":"2026-03-15T14:36:12.408984Z","shell.execute_reply":"2026-03-15T14:36:14.906714Z"}},"outputs":[{"name":"stdout","text":"Sampled 300 images\nWidth  — min: 39   max: 227   mean: 96   std: 31\nHeight — min: 44   max: 186   mean: 100   std: 26\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x350 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"The red dashed line shows where we resize to. Most images should be near or larger than this line.\n","output_type":"stream"}],"execution_count":15},{"cell_type":"markdown","source":"## 3 - Data Loading\n\n### Step 1 - Merging the Training Data\n\nWe have two labelled files: `train.csv` and `additional_train.csv`. The additional file contains some rows where `writer_id == -1`, meaning we know the pen used but not which person drew it.\n\nThe toggle `INCLUDE_UNKNOWN_WRITERS` (set to `True` below) controls whether we include those rows. The pen label is still valid even when the writer is unknown, so including them generally helps. But if you suspect those images are lower quality, set it to `False` to exclude them.\n\n### Step 2 - Stratified Train / Validation Split\n\nWe split the merged data 80% for training and 20% for validation. The word 'stratified' means we make sure both halves contain the same proportion of each pen class. Without stratification, a random split might put almost all pen-5 images in training and leave none for validation — making it impossible to measure how well the model handles pen 5.","metadata":{}},{"cell_type":"code","source":"# Merge training sources\nINCLUDE_UNKNOWN_WRITERS = True  # Set False to exclude writer_id == -1 rows\n\ncombined_df = pd.concat([train_df, add_train_df], ignore_index=True)\n\nif not INCLUDE_UNKNOWN_WRITERS:\n    before = len(combined_df)\n    # writer_id can be the integer -1 or the string '-1' depending on the file\n    combined_df = combined_df[\n        (combined_df['writer_id'] != -1) &\n        (combined_df['writer_id'] != '-1')\n    ].copy()\n    print(f'Excluded unknown writers: removed {before - len(combined_df)} rows')\n\n# Convert pen_id (1-8) to a 0-indexed label (0-7) that PyTorch loss expects\ncombined_df['label'] = combined_df['pen_id'].astype(int) - 1\n\nprint(f'Total labelled images: {len(combined_df):,}')\nprint('\\nPen distribution in combined set:')\nprint(combined_df['pen_id'].value_counts().sort_index().to_string())\n\n# Stratified 80 / 20 split\ntrain_split, val_split = train_test_split(\n    combined_df,\n    test_size=0.20,        # 20% of data goes to validation\n    random_state=SEED,\n    stratify=combined_df['label'],  # Preserve class proportions\n)\ntrain_split = train_split.reset_index(drop=True)\nval_split   = val_split.reset_index(drop=True)\n\nprint(f'\\nTrain split: {len(train_split):,} images')\nprint(f'Val   split: {len(val_split):,} images')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:14.908423Z","iopub.execute_input":"2026-03-15T14:36:14.909260Z","iopub.status.idle":"2026-03-15T14:36:14.941951Z","shell.execute_reply.started":"2026-03-15T14:36:14.909205Z","shell.execute_reply":"2026-03-15T14:36:14.941440Z"}},"outputs":[{"name":"stdout","text":"Total labelled images: 40,250\n\nPen distribution in combined set:\npen_id\n1    5050\n2    5000\n3    4950\n4    5000\n5    5100\n6    5050\n7    5050\n8    5050\n\nTrain split: 32,200 images\nVal   split: 8,050 images\n","output_type":"stream"}],"execution_count":16},{"cell_type":"markdown","source":"### Step 3 - Image Augmentation\n\nAugmentation is one of the most important tricks in computer vision. The idea is simple: instead of showing the model the exact same training images every epoch, we randomly modify each image slightly before feeding it in. This forces the model to learn the underlying pen stroke rather than memorising pixel positions.\n\n**Training augmentations explained one by one:**\n\n| Transform | What it does | Why it helps for circles |\n|-----------|-------------|-------------------------|\n| RandomResizedCrop | Crops a random part of the image and resizes to 224×224 | Teaches the model that the pen feature appears everywhere in the circle, not just the centre |\n| HorizontalFlip | Mirrors the image left-right | A circle is symmetric; the pen texture is the same from either side |\n| VerticalFlip | Mirrors top-bottom | Same reasoning as horizontal flip |\n| Rotate | Rotates by a random angle up to 30° | A circle looks the same from any angle |\n| ColorJitter | Randomly changes brightness, contrast, saturation | Simulates different scanner settings or lighting conditions |\n| ElasticTransform | Applies a rubber-sheet-like local warp | Simulates the way different writers press the pen at different angles |\n| CoarseDropout | Blacks out small random patches | Forces the model to use the whole stroke, not just one lucky patch |\n| CLAHE | Enhances local contrast | Brings out fine ink texture details that might be washed out in low-contrast scans |\n| Normalize | Subtracts ImageNet mean/std | Matches the pixel range the pretrained model was trained on |\n\nThe **validation transform** does nothing random only resize and normalize. This gives a fair, consistent measure of accuracy on untouched images.","metadata":{}},{"cell_type":"code","source":"# ImageNet normalisation constants\n# EfficientNetV2-S was pretrained on ImageNet with these exact mean and std values.\n# We must use the same values so the pixel distribution matches what the\n# model's pretrained weights expect.\nIMAGENET_MEAN = (0.485, 0.456, 0.406)\nIMAGENET_STD  = (0.229, 0.224, 0.225)\n\nprint(f'albumentations version: {A.__version__}')\n\n# Training augmentation pipeline (albumentations 2.x compatible)\ntrain_transform = A.Compose([\n\n    # FIXED: 2.x requires size=(H, W) tuple — 'height=' and 'width=' were removed.\n    # Randomly crops between 75-100% of the image then resizes to 224×224.\n    A.RandomResizedCrop(size=(IMG_SIZE, IMG_SIZE),\n                        scale=(0.75, 1.0), ratio=(0.9, 1.1), p=1.0),\n\n    # Orientation flips — free augmentation since circles are symmetric\n    A.HorizontalFlip(p=0.5),\n    A.VerticalFlip(p=0.3),\n\n    # border_mode still accepted in 2.x, but we drop it to keep code clean\n    A.Rotate(limit=30, p=0.6),\n\n    # Photometric variation — simulates different scanner settings\n    A.ColorJitter(brightness=0.3, contrast=0.3,\n                  saturation=0.2, hue=0.05, p=0.7),\n\n    # FIXED: alpha_affine removed in 2.x — just use alpha and sigma\n    A.ElasticTransform(alpha=120, sigma=6, p=0.25),\n\n    # FIXED: old max_holes / max_height / fill_value params renamed in 2.x.\n    # num_holes_range=(min, max), hole_height_range=(min, max), fill= (not fill_value=)\n    A.CoarseDropout(\n        num_holes_range=(1, 8),\n        hole_height_range=(8, IMG_SIZE // 8),\n        hole_width_range=(8, IMG_SIZE // 8),\n        fill=0,                              # ← was: fill_value=0\n        p=0.3,\n    ),\n\n    # Enhance local contrast to reveal fine ink texture\n    A.CLAHE(clip_limit=4.0, tile_grid_size=(8, 8), p=0.25),\n\n    # Match ImageNet normalisation and convert to (C, H, W) tensor\n    A.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n    ToTensorV2(),\n])\n\n# Validation / test pipeline (no randomness)\n# Resize still uses height= / width= in 2.x — no change needed here.\nval_transform = A.Compose([\n    A.Resize(height=IMG_SIZE, width=IMG_SIZE),\n    A.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),\n    ToTensorV2(),\n])\n\nprint(f'Training pipeline   : {len(train_transform.transforms)} transforms')\nprint(f'Validation pipeline : {len(val_transform.transforms)} transforms (resize + normalise only)')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:14.942730Z","iopub.execute_input":"2026-03-15T14:36:14.942997Z","iopub.status.idle":"2026-03-15T14:36:14.957702Z","shell.execute_reply.started":"2026-03-15T14:36:14.942977Z","shell.execute_reply":"2026-03-15T14:36:14.957125Z"}},"outputs":[{"name":"stdout","text":"albumentations version: 2.0.8\nTraining pipeline   : 10 transforms\nValidation pipeline : 3 transforms (resize + normalise only)\n","output_type":"stream"}],"execution_count":17},{"cell_type":"markdown","source":"### Step 4 - PyTorch Dataset and DataLoader\n\nA **Dataset** is a Python class that knows how to retrieve one training example. Think of it as a smart list: you ask for item number 500, it opens the 500th image file, applies the augmentation pipeline, and hands you back a (tensor, label) pair.\n\nA **DataLoader** wraps the Dataset and handles the mechanics of batching. It uses background worker processes (`num_workers=2`) to pre-load the next batch while the GPU is processing the current one, keeping the GPU busy at all times. `pin_memory=True` speeds up the transfer of image data from CPU RAM to GPU memory.\n\nThe `_load_image` method includes a graceful fallback: if an image file is missing, it returns a neutral grey image instead of crashing. This makes the pipeline robust to small dataset issues.","metadata":{}},{"cell_type":"code","source":"class CircleIDDataset(Dataset):\n    \"\"\"\n    Custom PyTorch Dataset for the CircleID pen classification task.\n\n    For a training row it returns (image_tensor, label).\n    For a test row (is_test=True) it returns (image_tensor, image_id).\n    \"\"\"\n\n    def __init__(self, df: pd.DataFrame, data_dir: Path,\n                 transform=None, is_test: bool = False):\n        self.df        = df.reset_index(drop=True)\n        self.data_dir  = data_dir\n        self.transform = transform\n        self.is_test   = is_test\n\n    def __len__(self) -> int:\n        return len(self.df)\n\n    def _load_image(self, path: Path) -> np.ndarray:\n        '''Load a single PNG as an RGB numpy array.'''\n        if path.exists():\n            return np.array(Image.open(path).convert('RGB'))\n        # If the file is missing, return a neutral grey image instead of crashing\n        return np.full((IMG_SIZE, IMG_SIZE, 3), 128, dtype=np.uint8)\n\n    def __getitem__(self, idx: int):\n        row   = self.df.iloc[idx]\n        image = self._load_image(self.data_dir / row['image_path'])\n\n        if self.transform is not None:\n            image = self.transform(image=image)['image']  # returns (C, H, W) tensor\n        else:\n            image = torch.from_numpy(image.transpose(2, 0, 1)).float() / 255.0\n\n        if self.is_test:\n            return image, str(row['image_id'])\n        return image, int(row['label'])\n\n\n# Build Dataset objects \ntrain_dataset = CircleIDDataset(train_split, DATA_DIR, transform=train_transform)\nval_dataset   = CircleIDDataset(val_split,   DATA_DIR, transform=val_transform)\ntest_dataset  = CircleIDDataset(test_df,     DATA_DIR, transform=val_transform,\n                                is_test=True)\n\n# Build DataLoader objects\n# drop_last=True in the train loader drops the final incomplete batch so that\n# batch normalisation layers always receive a full batch of 32 images.\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n                          num_workers=NUM_WORKERS, pin_memory=True, drop_last=True)\nval_loader   = DataLoader(val_dataset,   batch_size=BATCH_SIZE, shuffle=False,\n                          num_workers=NUM_WORKERS, pin_memory=True)\ntest_loader  = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False,\n                          num_workers=NUM_WORKERS, pin_memory=True)\n\n# Quick sanity check\nsample_imgs, sample_labels = next(iter(train_loader))\nprint(f'Train batches : {len(train_loader)}')\nprint(f'Val   batches : {len(val_loader)}')\nprint(f'Test  batches : {len(test_loader)}')\nprint(f'One batch shape : {sample_imgs.shape}  (batch_size x channels x H x W)')\nprint(f'Label range     : {sample_labels.min().item()} to {sample_labels.max().item()}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:14.960127Z","iopub.execute_input":"2026-03-15T14:36:14.960503Z","iopub.status.idle":"2026-03-15T14:36:16.023087Z","shell.execute_reply.started":"2026-03-15T14:36:14.960474Z","shell.execute_reply":"2026-03-15T14:36:16.022401Z"}},"outputs":[{"name":"stdout","text":"Train batches : 1006\nVal   batches : 252\nTest  batches : 185\nOne batch shape : torch.Size([32, 3, 224, 224])  (batch_size x channels x H x W)\nLabel range     : 0 to 7\n","output_type":"stream"}],"execution_count":18},{"cell_type":"markdown","source":"---\n## 4 - Model Architecture\n\n### Transfer Learning: Standing on the Shoulders of Giants\n\nTraining a deep neural network from scratch requires millions of images and weeks of GPU time. Transfer learning avoids this by reusing a network that was already trained on a massive dataset.\n\nWe use **EfficientNetV2-S**, which was trained on ImageNet (1.2 million photos, 1000 categories). During that training it learned to detect edges, textures, colour gradients, and shapes. We discard only the final 1000-class prediction layer and replace it with a new layer that predicts 8 pen classes. The rest of the network keeps its pretrained weights and will be fine-tuned on our circle images.\n\n**Our custom head:**\n\n```\nEfficientNetV2-S backbone  →  feature vector (e.g. 1280 numbers)\n     LayerNorm             →  stabilises the scale of the features\n     Dropout(0.3)          →  randomly zeros 30% of features to prevent overfitting\n     Linear(feat_dim, 8)   →  maps features to 8 pen-class scores\n```\n\n**LayerNorm** normalises the feature vector so all values have a consistent scale, which helps the dropout and linear layers work better.\n\n**Dropout(0.3)** randomly turns off 30% of neurons during each training step. This forces the remaining neurons to do the work, preventing any single neuron from becoming too dominant. During validation, dropout is turned off automatically.","metadata":{}},{"cell_type":"code","source":"MODEL_NAME   = 'tf_efficientnetv2_s.in21k_ft_in1k'\n\nprint(f'Device     : {DEVICE}')\nprint(f'timm       : {timm.__version__}')\nprint(f'Model      : {MODEL_NAME}')\n\n# ── Model definition ──────────────────────────────────────────────────────────\nclass CircleModel(nn.Module):\n    \"\"\"\n    Wraps a timm backbone with a custom 8-class head.\n\n    WHY a wrapper class instead of backbone.head = ... ?\n    timm models each use their own internal attribute name for the final layer\n    ('head', 'classifier', 'fc', etc.).  Assigning backbone.head = ... when\n    the model's forward() calls self.classifier means the assignment is silently\n    ignored — the model returns raw 1280-d features and you get the shape error:\n        ValueError: shapes (8,) (1280,) (8,)\n    This wrapper calls self.backbone(x) explicitly, so the output is always\n    the pooled feature vector, then passes it through self.head — guaranteeing\n    8-class logits regardless of timm internals.\n    \"\"\"\n\n    def __init__(self, model_name: str = MODEL_NAME,\n                 num_classes: int = NUM_CLASSES,\n                 pretrained: bool = True):\n        super().__init__()\n        # num_classes=0 → timm returns pooled features, not class scores\n        self.backbone = timm.create_model(\n            model_name, pretrained=pretrained, num_classes=0\n        )\n        feat_dim = self.backbone.num_features   # e.g. 1280 for EffNetV2-S\n        self.head = nn.Sequential(\n            nn.LayerNorm(feat_dim),\n            nn.Dropout(p=0.3),\n            nn.Linear(feat_dim, num_classes),\n        )\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        features = self.backbone(x)   # (B, 1280)\n        return self.head(features)    # (B, 8)  ← always correct\n\n\nmodel = CircleModel(pretrained=True).to(DEVICE)\nfeat_dim = model.backbone.num_features\n\ntotal_params     = sum(p.numel() for p in model.parameters())\ntrainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\nprint(f'\\nBackbone feature dim : {feat_dim}')\nprint(f'Total params         : {total_params:,}')\nprint(f'Trainable params     : {trainable_params:,}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:16.024421Z","iopub.execute_input":"2026-03-15T14:36:16.024668Z","iopub.status.idle":"2026-03-15T14:36:21.600788Z","shell.execute_reply.started":"2026-03-15T14:36:16.024644Z","shell.execute_reply":"2026-03-15T14:36:21.600229Z"}},"outputs":[{"name":"stdout","text":"Device     : cuda\ntimm       : 1.0.24\nModel      : tf_efficientnetv2_s.in21k_ft_in1k\n","output_type":"stream"},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"model.safetensors:   0%|          | 0.00/86.5M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"22664ea35ec349bba3ba11d9e609b627"}},"metadata":{}},{"name":"stdout","text":"\nBackbone feature dim : 1280\nTotal params         : 20,190,296\nTrainable params     : 20,190,296\n","output_type":"stream"}],"execution_count":19},{"cell_type":"markdown","source":"### Loss Function, Optimiser, and Learning Rate Scheduler\n\n**Label-smoothed CrossEntropyLoss** is the standard loss for multi-class classification. Normally the loss trains the model to predict exactly 1.0 for the correct class and 0.0 for all others. Label smoothing of 0.1 softens this to 0.9 / 0.1-spread, which prevents the model from becoming overconfident and helps it generalise to unseen writers.\n\n**AdamW optimiser** updates the weights based on the gradient of the loss. The 'W' means 'weight decay' — a penalty that discourages very large weights, similar to how a teacher penalises a student who memorises rather than understands. We use different weight decay settings for the main weights vs. bias and normalisation parameters (which should not be penalised).\n\n**Warm-up + cosine decay scheduler** controls how big the weight-update steps are over time. For the first 5% of training we gradually increase the learning rate from near-zero to the full value (warm-up). Then we slowly decrease it following a cosine curve until it reaches near-zero at the end of training. Large steps early, tiny precise steps later.\n\n**GradScaler (mixed precision)** lets most calculations use 16-bit floating point instead of 32-bit. This roughly doubles speed on modern GPUs with no meaningful accuracy loss. The scaler prevents gradients from underflowing to zero in 16-bit.","metadata":{}},{"cell_type":"code","source":"# Loss function\ncriterion = nn.CrossEntropyLoss(label_smoothing=LABEL_SMOOTH)\n\n# Optimiser with per-group weight decay\n# Bias and normalisation weights are excluded from weight decay because\n# penalising them hurts rather than helps generalisation.\nNO_DECAY = {'bias', 'LayerNorm.weight', 'layer_norm.weight', 'norm'}\nparam_groups = [\n    {\n        'params': [p for n, p in model.named_parameters()\n                   if not any(nd in n for nd in NO_DECAY)],\n        'weight_decay': WEIGHT_DECAY,\n    },\n    {\n        'params': [p for n, p in model.named_parameters()\n                   if any(nd in n for nd in NO_DECAY)],\n        'weight_decay': 0.0,\n    },\n]\noptimizer = optim.AdamW(param_groups, lr=LR)\n\n# Warm-up + cosine decay scheduler\ntotal_steps  = NUM_EPOCHS * len(train_loader)\nwarmup_steps = int(0.05 * total_steps)   # First 5% of steps = warm-up phase\n\ndef lr_lambda(step: int) -> float:\n    '''Linear ramp-up for warmup_steps, then smooth cosine decay to ~0.'''\n    if step < warmup_steps:\n        return float(step) / float(max(1, warmup_steps))\n    progress = float(step - warmup_steps) / float(max(1, total_steps - warmup_steps))\n    return max(0.0, 0.5 * (1.0 + np.cos(np.pi * progress)))\n\nscheduler = optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)\n\n# Mixed precision scaler\n# Enabled only on GPU — on CPU it adds overhead without any speed benefit.\nscaler = GradScaler(enabled=(DEVICE.type == 'cuda'))\n\nprint(f'\\nLoss        : CrossEntropyLoss  label_smoothing={LABEL_SMOOTH}')\nprint(f'Optimiser   : AdamW  |  LR={LR}  |  weight_decay={WEIGHT_DECAY}')\nprint(f'Total steps : {total_steps:,}  (warm-up: {warmup_steps} steps)')\nprint(f'Mixed prec. : {DEVICE.type == \"cuda\"}')\nprint('\\nAll components ready — proceed to the training loop.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:21.601715Z","iopub.execute_input":"2026-03-15T14:36:21.602031Z","iopub.status.idle":"2026-03-15T14:36:21.613772Z","shell.execute_reply.started":"2026-03-15T14:36:21.602009Z","shell.execute_reply":"2026-03-15T14:36:21.613118Z"}},"outputs":[{"name":"stdout","text":"\nLoss        : CrossEntropyLoss  label_smoothing=0.1\nOptimiser   : AdamW  |  LR=0.0003  |  weight_decay=0.01\nTotal steps : 20,120  (warm-up: 1006 steps)\nMixed prec. : True\n\nAll components ready — proceed to the training loop.\n","output_type":"stream"}],"execution_count":20},{"cell_type":"markdown","source":"---\n## 5 - Training Loop\n\nOne training **epoch** means the model has seen every image in the training set once. We run 20 epochs total, so the model sees every image 20 times (each time with a different random augmentation).\n\n**What happens in each training step:**\n\n1. Load a batch of 32 images and their labels\n2. Run them through the model to get 8-class predictions (forward pass)\n3. Compute the loss: how wrong were those predictions?\n4. Run backpropagation: compute how much each weight contributed to the error\n5. Gradient clipping: cap very large gradients at 1.0 so no single step is too big\n6. Optimiser step: nudge every weight slightly in the direction that reduces the loss\n7. Scheduler step: update the learning rate\n\nAfter each epoch we run the model on the **validation set** without updating any weights. This gives an honest estimate of how well the model generalises. We save the model whenever the validation accuracy improves — that saved checkpoint is our best model.","metadata":{}},{"cell_type":"code","source":"def train_one_epoch(model, loader, criterion, optimizer,\n                    scheduler, scaler, device, epoch: int) -> float:\n    '''\n    Runs one full pass over the training data.\n    Returns the average loss across all batches.\n    '''\n    model.train()  # Enables dropout and batch-norm training behaviour\n    total_loss = 0.0\n    pbar = tqdm(loader, desc=f'[Epoch {epoch:02d} Train]', leave=False)\n\n    for imgs, labels in pbar:\n        imgs   = imgs.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        optimizer.zero_grad()  # Clear gradients from the previous step\n\n        # autocast switches to 16-bit arithmetic on GPU for speed\n        with autocast(enabled=(device.type == 'cuda')):\n            logits = model(imgs)           # Shape: (32, 8)\n            loss   = criterion(logits, labels)\n\n        scaler.scale(loss).backward()      # Backprop with scaled gradients\n\n        # Unscale then clip: prevents any single gradient from being too large\n        scaler.unscale_(optimizer)\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n\n        scaler.step(optimizer)             # Update model weights\n        scaler.update()                    # Update the scaler for next step\n        scheduler.step()                   # Update learning rate\n\n        total_loss += loss.item() * imgs.size(0)\n        pbar.set_postfix(\n            loss=f'{loss.item():.4f}',\n            lr=f'{scheduler.get_last_lr()[0]:.2e}'\n        )\n\n    return total_loss / len(loader.dataset)\n\n\n@torch.no_grad()  # Disable gradient computation — saves memory and speeds up val\ndef validate(model, loader, criterion, device) -> tuple:\n    '''\n    Evaluates the model on the validation set.\n    Returns (average_loss, accuracy_fraction).\n    '''\n    model.eval()   # Disables dropout so predictions are deterministic\n    total_loss, n_correct = 0.0, 0\n\n    for imgs, labels in tqdm(loader, desc='[Val]', leave=False):\n        imgs   = imgs.to(device, non_blocking=True)\n        labels = labels.to(device, non_blocking=True)\n\n        with autocast(enabled=(device.type == 'cuda')):\n            logits = model(imgs)\n            loss   = criterion(logits, labels)\n\n        preds      = logits.argmax(dim=1)   # Predicted class = highest score\n        n_correct  += (preds == labels).sum().item()\n        total_loss += loss.item() * imgs.size(0)\n\n    avg_loss = total_loss / len(loader.dataset)\n    accuracy = n_correct  / len(loader.dataset)\n    return avg_loss, accuracy\n\nprint('Training and validation functions defined.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:21.614526Z","iopub.execute_input":"2026-03-15T14:36:21.614714Z","iopub.status.idle":"2026-03-15T14:36:21.631904Z","shell.execute_reply.started":"2026-03-15T14:36:21.614696Z","shell.execute_reply":"2026-03-15T14:36:21.631308Z"}},"outputs":[{"name":"stdout","text":"Training and validation functions defined.\n","output_type":"stream"}],"execution_count":21},{"cell_type":"markdown","source":"Now we run the main training loop for 20 epochs. Watch the `val_acc` column - it should rise over time. The marker `<-- best` appears whenever the model beats its previous best validation accuracy and a checkpoint is saved to disk.","metadata":{}},{"cell_type":"code","source":"# Skip training if a saved checkpoint already exists\n# This means you can re-run the whole notebook without waiting 4 hours again.\n# To force a fresh training run, delete best_model.pth and run this cell again.\n\nif CHECKPOINT.exists():\n    print(f'Checkpoint found at {CHECKPOINT} — loading saved results, skipping training.')\n    _ckpt = torch.load(CHECKPOINT, map_location=DEVICE)\n    model.load_state_dict(_ckpt['model_state'])\n    best_val_acc = _ckpt['val_acc']\n    best_epoch   = _ckpt['epoch']\n    # Rebuild history as a single-entry record so later cells don't break\n    history = {\n        'train_loss': [_ckpt.get('train_loss', 0.0)],\n        'val_loss'  : [_ckpt['val_loss']],\n        'val_acc'   : [_ckpt['val_acc']],\n    }\n    print(f'Loaded  : epoch {best_epoch + 1}  val_acc={best_val_acc:.4f}')\n    print('To retrain: delete best_model.pth and re-run this cell.')\n\nelse:\n    # Main training loop\n    history = {'train_loss': [], 'val_loss': [], 'val_acc': []}\n    best_val_acc = 0.0\n    best_epoch   = 0\n\n    print(f'Training {MODEL_NAME} for {NUM_EPOCHS} epochs on {DEVICE}')\n    print('=' * 70)\n\n    for epoch in range(NUM_EPOCHS):\n        train_loss        = train_one_epoch(\n            model, train_loader, criterion,\n            optimizer, scheduler, scaler, DEVICE, epoch + 1\n        )\n        val_loss, val_acc = validate(model, val_loader, criterion, DEVICE)\n\n        history['train_loss'].append(train_loss)\n        history['val_loss'].append(val_loss)\n        history['val_acc'].append(val_acc)\n\n        marker = ''\n        if val_acc > best_val_acc:\n            best_val_acc = val_acc\n            best_epoch   = epoch\n            torch.save({\n                'epoch'      : epoch,\n                'model_state': model.state_dict(),\n                'val_acc'    : val_acc,\n                'val_loss'   : val_loss,\n                'train_loss' : train_loss,   # also save train_loss for history reload\n            }, CHECKPOINT)\n            marker = '  <-- best'\n\n        current_lr = scheduler.get_last_lr()[0]\n        print(\n            f'Epoch {epoch+1:02d}/{NUM_EPOCHS}  '\n            f'train_loss={train_loss:.4f}  '\n            f'val_loss={val_loss:.4f}  '\n            f'val_acc={val_acc:.4f}  '\n            f'lr={current_lr:.2e}'\n            f'{marker}'\n        )\n\n    print('=' * 70)\n    print(f'Best validation accuracy: {best_val_acc:.4f} at epoch {best_epoch + 1}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-15T14:36:21.632826Z","iopub.execute_input":"2026-03-15T14:36:21.633220Z","iopub.status.idle":"2026-03-15T16:06:26.996547Z","shell.execute_reply.started":"2026-03-15T14:36:21.633166Z","shell.execute_reply":"2026-03-15T16:06:26.995688Z"}},"outputs":[{"name":"stdout","text":"Training tf_efficientnetv2_s.in21k_ft_in1k for 20 epochs on cuda\n======================================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"[Epoch 01 Train]:   0%|          | 0/1006 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"[Val]:   0%|          | 0/252 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":""}},"metadata":{}},{"name":"stdout","text":"Epoch 01/20  train