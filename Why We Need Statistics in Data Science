    "num_cols = ['Age', 'Education', 'Usage', 'Fitness', 'Income', 'Miles']\n",
    "\n",
    "rows = []\n",
    "for c in num_cols:\n",
    "    s = data[c]\n",
    "    q1, q2, q3 = s.quantile([0.25, 0.50, 0.75])     # Q1, Q2 (median), Q3\n",
    "    iqr = q3 - q1                                    # spread of the middle 50%\n",
    "    low_fence  = q1 - 1.5 * iqr                      # below this = outlier\n",
    "    high_fence = q3 + 1.5 * iqr                      # above this = outlier\n",
    "    n_out = ((s < low_fence) | (s > high_fence)).sum()\n",
    "    rows.append([q1, q2, q3, iqr, low_fence, high_fence, n_out])\n",
    "\n",
    "iqr_table = pd.DataFrame(rows, index=num_cols,\n",
    "    columns=['Q1', 'Q2 (median)', 'Q3', 'IQR', 'low fence', 'high fence', '# outliers'])\n",
    "iqr_table.round(1)"
   ]
