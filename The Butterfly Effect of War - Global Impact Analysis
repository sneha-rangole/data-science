    "# DATASET 2 — Monthly Economic Indicators (2018–2024)\n",
    "# Reflects real patterns from: World Bank, IMF, FAO, UNHCR\n",
    "\n",
    "# Create a monthly timeline from Jan 2018 to Dec 2024\n",
    "dates = pd.date_range(start='2018-01-01', end='2024-12-01', freq='MS')\n",
    "n = len(dates)\n",
    "np.random.seed(42)  # makes results reproducible\n",
    "\n",
    "# Oil price (USD per barrel)\n",
    "# Real pattern: COVID crash 2020, Ukraine spike Feb 2022, then easing\n",
    "oil_base   = np.linspace(65, 75, n) + np.random.normal(0, 3, n)\n",
    "covid_dip  = np.where((dates >= '2020-03-01') & (dates <= '2020-06-01'),\n",
    "                      -40, 0)\n",
    "ukraine_spike = np.where((dates >= '2022-02-01') & (dates <= '2022-08-01'),\n",
    "                          +45, 0)\n",
    "ukraine_spike2 = np.where((dates >= '2022-08-01') & (dates <= '2023-06-01'),\n",
    "                           +15, 0)\n",
    "oil_price  = np.clip(oil_base + covid_dip + ukraine_spike + ukraine_spike2, 15, 140)\n",
    "\n",
    "# Global food price index (FAO baseline = 100)\n",
    "food_base  = np.linspace(95, 115, n) + np.random.normal(0, 2, n)\n",
    "food_spike = np.where((dates >= '2022-02-01') & (dates <= '2022-05-01'),\n",
    "                       +45, 0)\n",
    "food_ease  = np.where((dates >= '2022-05-01') & (dates <= '2023-12-01'),\n",
    "                       +15, 0)\n",
    "food_index = food_base + food_spike + food_ease\n",
    "\n",
    "# Global inflation rate (%)\n",
    "infl_base  = np.linspace(2.1, 2.8, n) + np.random.normal(0, 0.2, n)\n",
    "infl_spike = np.where((dates >= '2021-09-01') & (dates <= '2023-06-01'),\n",
    "                       +5.5, 0)\n",
    "infl_ease  = np.where((dates >= '2023-06-01') & (dates <= '2024-12-01'),\n",
    "                       +1.5, 0)\n",
    "inflation  = np.clip(infl_base + infl_spike + infl_ease, 0, 12)\n",
    "\n",
    "# Global refugee count (millions)\n",
    "refugee_base  = np.linspace(25, 35, n)\n",
    "syria_rise    = np.where(dates >= '2018-01-01', +8, 0)\n",
    "ukraine_rise  = np.where(dates >= '2022-03-01', +10, 0)\n",
    "ukraine_rise2 = np.where(dates >= '2022-06-01', +2,  0)\n",
    "gaza_rise     = np.where(dates >= '2023-10-01', +2,  0)\n",
    "refugees      = refugee_base + syria_rise + ukraine_rise + ukraine_rise2 + gaza_rise\n",
    "\n",
    "# Combine into one DataFrame\n",
    "econ = pd.DataFrame({\n",
    "    'date':        dates,\n",
    "    'oil_price':   np.round(oil_price,  2),\n",
    "    'food_index':  np.round(food_index, 1),\n",
    "    'inflation':   np.round(inflation,  2),\n",
    "    'refugees_M':  np.round(refugees,   1)\n",
    "})\n",
    "econ.set_index('date', inplace=True)\n",
    "\n",
    "print(\"Economic Indicators Dataset\")\n",
    "print(f\"Shape: {econ.shape[0]} months × {econ.shape[1]} indicators\")\n",
    "print(f\"Period: {econ.index[0].strftime('%b %Y')} → {econ.index[-1].strftime('%b %Y')}\")\n",
    "print()\n",
    "econ.head(8)"
