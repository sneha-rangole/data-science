    "        0.3,   # Pakistan-Afghanistan — early estimates, Feb 2026 conflict\n",
    "        0.5,   # Lebanon — conflict resumed Mar 2, 2026 after ceasefire collapse\n",
    "    ],\n",
    "    # GDP contraction % in the conflict country — IMF / World Bank / African Dev Bank\n",
    "    'gdp_shock_pct': [\n",
    "        -8.5,   # Iraq\n",
    "        -22.4,  # Syria\n",
    "        -11.2,  # Libya\n",
    "        -30.1,  # Yemen\n",
    "        -18.0,  # Myanmar — 18% GDP drop in 2021 (UNDP/CNN); still 12% below pre-coup\n",
    "        -29.1,  # Ukraine\n",
    "        -37.5,  # Sudan — GDP contracted 37.5% in 2023 (African Development Bank)\n",
    "        -40.5,  # Gaza\n",
    "        -5.0,   # Iran — sanctions tightened + strike damage (estimated)\n",
    "        -3.5,   # Pakistan — economic strain from conflict + sanctions risk (estimated)\n",
    "        -8.0,   # Lebanon — conflict restart layered on existing economic collapse (estimated)\n",
    "    ],\n",
    "    # Countries significantly affected by ripple effects (energy, food, migration, politics)\n",
    "    'neighbors_affected': [\n",
    "        5,   # Iraq → Iran, Kuwait, Syria, Jordan, Turkey\n",
    "        6,   # Syria → Turkey, Lebanon, Jordan, Iraq, Europe, Egypt\n",
    "        4,   # Libya → Tunisia, Chad, Egypt, Italy (migration)\n",
    "        4,   # Yemen → Saudi Arabia, Oman, Egypt, global shipping\n",
    "        5,   # Myanmar → Thailand, India, Bangladesh, China, Laos\n",
    "        8,   # Ukraine → all of Europe (energy), Middle East (wheat), Global\n",
