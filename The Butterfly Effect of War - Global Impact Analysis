     "output_type": "stream",
     "text": [
      "Butterfly Chain Generator is ready.\n",
      "   Default max_tokens = 900 (fits full response on T4 GPU)\n",
      "   For more detail    : generate_butterfly_chain(event, max_tokens=1200)\n"
     ]
