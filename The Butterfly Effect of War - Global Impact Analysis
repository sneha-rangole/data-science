   "source": [
    "# THE BUTTERFLY EFFECT CHAIN GENERATOR\n",
    "# Input : a conflict event (plain English)\n",
    "# Output: a structured cause → effect chain (AI-generated)\n",
    "\n",
    "def generate_butterfly_chain(conflict_event: str,\n",
    "                              max_tokens: int = 1200) -> str:\n",
    "    \"\"\"\n",
    "    Takes a war/conflict event and returns a structured\n",
    "    cause-and-effect chain showing its global ripple effects.\n",
    "\n",
    "    Args:\n",
    "        conflict_event: Plain English description of a conflict\n",
    "                        e.g. \"Russia invades Ukraine in February 2022\"\n",
    "        max_tokens    : Maximum length of AI response.\n",
    "                        900 is the safe minimum to fit all 5 sections.\n",
    "                        Increase to 1200 if you want more detail.\n",
    "\n",
    "    Returns:\n",
    "        A formatted string showing the butterfly effect chain\n",
    "    \"\"\"\n",
    "\n",
    "    # Build the prompt\n",
    "    # IMPORTANT: We tell the model to be CONCISE per section.\n",
    "    # Without this, it writes long paragraphs and runs out of tokens\n",
    "    # before reaching sections 4, 5, KEY NUMBERS, and HIDDEN RIPPLE.\n",
    "    prompt_text = f\"\"\"You are a concise geopolitical economist. Analyze conflict ripple effects.\n",
    "\n",
    "Conflict: \"{conflict_event}\"\n",
    "\n",
    "Write EXACTLY this structure. Keep each point to 1-2 sentences maximum. Do not skip any section.\n",
    "\n",
    "TRIGGER: [one sentence]\n",
    "\n",
    "CHAIN REACTION:\n",
    "1. Immediate (days/weeks): [1-2 sentences]\n",
    "2. Short-term (months): [1-2 sentences]\n",
    "3. Medium-term (6-12 months): [1-2 sentences]\n",
    "4. Long-term (1-3 years): [1-2 sentences]\n",
    "5. Global systemic: [1-2 sentences]\n",
    "\n",
    "COUNTRIES MOST AFFECTED: [3-4 countries, one line each with reason]\n",
    "\n",
    "KEY NUMBERS: [exactly 3 statistics with source or year]\n",
    "\n",
    "HIDDEN RIPPLE: [one surprising non-obvious consequence, 2-3 sentences]\"\"\"\n",
    "\n",
    "    # Format for Gemma 3's chat template\n",
    "    messages = [{\"role\": \"user\", \"content\": prompt_text}]\n",
    "    formatted = tokenizer.apply_chat_template(\n",
    "        messages,\n",
    "        tokenize=False,\n",
    "        add_generation_prompt=True\n",
    "    )\n",
    "\n",
    "    # Tokenize (convert text → numbers)\n",
    "    # max_length=1500 gives the prompt enough room without hitting GPU limits\n",
    "    inputs = tokenizer(\n",
    "        formatted,\n",
    "        return_tensors=\"pt\",\n",
    "        truncation=True,\n",
    "        max_length=1500\n",
    "    ).to(model.device)\n",
    "\n",
    "    # Count how many tokens the prompt itself used\n",
    "    prompt_token_count = inputs['input_ids'].shape[1]\n",
    "\n",
    "    # Generate the responses\n",
    "    with torch.no_grad():   # no gradient tracking — saves ~40% GPU memory\n",
    "        output_ids = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_tokens,   # tokens for the ANSWER only (not prompt)\n",
    "            do_sample=True,\n",
    "            temperature=0.7,             # 0=robotic, 1=creative. 0.7 is balanced\n",
    "            top_p=0.9,                   # sample from top 90% probable words\n",
    "            repetition_penalty=1.15,     # penalise repeating the same phrase\n",
    "            pad_token_id=tokenizer.eos_token_id\n",
    "        )\n",
    "\n",
    "    # Decode only the NEW tokens (the answer)\n",
    "    # output_ids contains [prompt tokens + answer tokens]\n",
    "    # We slice off the prompt tokens so we only decode the answer\n",
    "    answer_ids = output_ids[0][prompt_token_count:]\n",
    "    response   = tokenizer.decode(answer_ids, skip_special_tokens=True).strip()\n",
    "\n",
    "    # Sanity check: warn if response was cut off\n",
    "    if 'HIDDEN RIPPLE' not in response and 'HIDDEN RIPPLE' not in response:\n",
    "        response += (\n",
    "            \"\\n\\n  NOTE: Response may have been cut off. \"\n",
    "            \"Re-run with max_tokens=1200 for the full output.\"\n",
    "        )\n",
    "\n",
    "    return response\n",
    "\n",
    "print(\"Butterfly Chain Generator is ready.\")\n",
    "print(\"   Default max_tokens = 900 (fits full response on T4 GPU)\")\n",
    "print(\"   For more detail    : generate_butterfly_chain(event, max_tokens=1200)\")"
