    "        -8.0,   # Lebanon — conflict restart layered on existing economic collapse (estimated)\n",
    "    ],\n",
    "    # Countries significantly affected by ripple effects (energy, food, migration, politics)\n",
    "    'neighbors_affected': [\n",
    "        5,   # Iraq → Iran, Kuwait, Syria, Jordan, Turkey\n",
    "        6,   # Syria → Turkey, Lebanon, Jordan, Iraq, Europe, Egypt\n",
    "        4,   # Libya → Tunisia, Chad, Egypt, Italy (migration)\n",
