   "source": [
    "# All tunable settings live here \n",
    "SEED         = 42        # Fixed seed for reproducibility\n",
    "IMG_SIZE     = 224       # Every image is resized to 224 x 224 pixels\n",
    "BATCH_SIZE   = 32        # 32 images processed together per training step\n",
    "NUM_EPOCHS   = 20        # Number of full passes through the training data\n",
    "LR           = 3e-4      # Starting learning rate\n",
    "WEIGHT_DECAY = 1e-2      # Regularisation penalty on large weights\n",
    "NUM_CLASSES  = 8         # Eight pens = eight classes\n",
    "LABEL_SMOOTH = 0.1       # Prevents the model from being overconfident\n",
    "MODEL_NAME   = 'efficientnetv2_s'  # Pretrained backbone from timm\n",
    "NUM_WORKERS  = 2         # Background CPU processes that pre-load images\n",
    "TTA_STEPS    = 5         # Number of augmented views used at test time\n",
    "\n",
    "# Where the competition data lives \n",
    "# On Kaggle the path is /kaggle/input/<dataset-name>.\n",
    "# If you run locally, point DATA_DIR to your own folder.\n",
    "DATA_DIR = Path('/kaggle/input/competitions/icdar-2026-circleid-pen-classification')\n",
    "if not DATA_DIR.exists():\n",
    "    DATA_DIR = Path('.')   # Fallback: current working directory\n",
    "    print(f'[INFO] DATA_DIR set to: {DATA_DIR.resolve()}')\n",
    "\n",
    "CHECKPOINT  = Path('best_model.pth')    # Where to save the best model\n",
    "SUBMIT_PATH = Path('submission_pen.csv') # Final submission file\n",
    "\n",
    "# Detect GPU \n",
    "# If a GPU is available we use it. Otherwise training falls back to CPU,\n",
    "# which is much slower but still works for testing the pipeline.\n",
    "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {DEVICE}')\n",
    "if DEVICE.type == 'cuda':\n",
    "    print(f'GPU   : {torch.cuda.get_device_name(0)}')\n",
    "\n",
    "# Fix all random seeds\n",
    "# We lock the seed in Python, NumPy, and PyTorch so that every random\n",
    "# choice (weight initialisation, batch shuffling, augmentations) is the\n",
    "# same every time this notebook is run from top to bottom.\n",
    "def seed_everything(seed: int = SEED):\n",
    "    random.seed(seed)\n",
    "    os.environ['PYTHONHASHSEED'] = str(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "    torch.backends.cudnn.benchmark     = False\n",
    "\n",
    "seed_everything(SEED)\n",
    "print(f'Seed {SEED} fixed across Python / NumPy / PyTorch.')"
   ]
